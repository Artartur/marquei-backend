generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  MANAGER
  PROFESSIONAL
}

model User {
  id        String   @id @default(uuid())
  cpf       String   @unique
  email     String   @unique
  name      String
  password  String
  phone     String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
